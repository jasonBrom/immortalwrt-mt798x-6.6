CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_bananapi_bpi-r4=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_bananapi_bpi-r4="kmod-mediatek_hnat kmod-mt7996-firmware kmod-mt7996-233-firmware luci-theme-argon luci-app-argon-config luci-i18n-base-zh-cn"

# LuCI 中文
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# Argon 主题
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# MTK HNAT 加速
CONFIG_PACKAGE_kmod-mediatek_hnat=y

# BE14 方向：使用 BPI-R4 的 MT7996 相关固件包
CONFIG_PACKAGE_kmod-mt7996-firmware=y
CONFIG_PACKAGE_kmod-mt7996-233-firmware=y

# BPI-R4 默认已为 192.168.6.1（由默认设置包提供）
